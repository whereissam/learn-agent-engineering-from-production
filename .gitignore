# Dependencies
node_modules/

# Secrets. .env.example is the template and is committed; .env holds your real key and is not.
.env
.env.*
!.env.example

# Things produced at run time
*.log
# Exception: Lesson 19's corpus *is* .log, and it is course content rather than run output
# (same reason as lesson-20's corpus/ and lesson-06's data/sessions/: generated from a
#  fixture, but it has to be visible and readable on GitHub)
!lesson-19-delegation/workspace/logs/*.log
.sessions/
lesson-*/.sessions/
lesson-06-domain-tools/reports/
lesson-07-evaluation/results/
lesson-10-agent-server/sessions/

# Editors / operating systems
.DS_Store
.idea/
.vscode/
.claude/
*.swp
lesson-15-memory/.memory/
lesson-16-skills/.skills/
lesson-09-unattended/outbox/

# Lesson 29's shadow git (must not be committed)
lesson-29-evidence/.snapshots/

# Lesson 18's run records
lesson-18-scheduling/.state/

# Lesson 33's workflow journals and side-effect ledgers
lesson-33-durable/.runs/

# Lesson 34's invocation journals and charge ledgers
lesson-34-idempotency/.runs/

# Lesson 35's demo really writes and moves files. It cleans up after itself, but
# an interrupted run can leave these behind, and one of them is a copy of the
# fixture secret — which is Step 9's whole point, so it must not be committed.
lesson-35-sandbox/workspace/stolen.txt
lesson-35-sandbox/workspace/tmp-*.txt
lesson-35-sandbox/workspace/link.txt
lesson-35-sandbox/outside/pwned.txt

# My personal writing standard, not committed
de-ai-tone.md
